{
  "name": "faropdf",
  "private": true,
  "version": "0.1.2",
  "description": "FaroPDF 是一个独立 PDF 阅读器，面向律师日常处理卷宗、证据、判决、合同和扫描材料。",
  "homepage": "https://github.com/cat-xierluo/FaroPDF",
  "repository": {
    "type": "git",
    "url": "https://github.com/cat-xierluo/FaroPDF.git"
  },
  "author": {
    "name": "杨卫薪律师",
    "url": "https://github.com/cat-xierluo"
  },
  "type": "module",
  "engines": {
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc --noEmit --project config/tsconfig.json && vite build --config config/vite.config.ts",
    "typecheck": "tsc --noEmit --project config/tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "lint": "eslint . --config config/eslint.config.js",
    "preview": "vite preview --config config/vite.config.ts",
    "tauri": "tauri",
    "updater:manifest": "node scripts/create-updater-manifest.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "2.10.1",
    "lucide-react": "1.17.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.0.227",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "10.4.1",
    "jsdom": "29.1.1",
    "playwright": "1.60.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.60.1",
    "vite": "^7.0.4",
    "vitest": "4.1.8"
  }
}
